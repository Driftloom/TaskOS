{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This project typechecks with `tsc -p tsconfig.json --noEmit`. Combining
    // --noEmit with the inherited `incremental: true` lets a stale
    // .tsbuildinfo report success WITHOUT re-checking sources, so the
    // verification gate silently passes on code that does not compile.
    // --noEmit produces no output to cache, so incremental buys nothing here.
    // Force a full check every run.
    "incremental": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../lib/db"
    },
    {
      "path": "../../lib/api-zod"
    }
  ]
}
