{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Cadence — Personal Task & Time OS",
  "short_name": "Cadence",
  "description": "Fast mobile capture, daily time-blocking, focus rounds, and intelligent auto-rescheduling. Installable personal task OS.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        {
          "pathname": "/*"
        }
      ]
    },
    "new_tab_button": {
      "url": "/?action=capture"
    }
  },
  "note_taking": {
    "new_note_url": "/?action=capture"
  },
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "business"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "auto"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://cadence-task-os.vercel.app/manifest.webmanifest",
      "id": "app.cadence.taskos"
    }
  ],
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://cadence-task-os.vercel.app"
    },
    {
      "type": "origin",
      "origin": "https://cadence-task-os.onrender.com"
    }
  ],
  "file_handlers": [
    {
      "action": "/?action=import_file",
      "name": "Cadence Task & Schedule Files",
      "accept": {
        "text/calendar": [".ics"],
        "application/json": [".json"],
        "text/plain": [".txt"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+cadence",
      "url": "/?action=protocol&uri=%s"
    }
  ],
  "widgets": [
    {
      "name": "Cadence Daily Tasks",
      "description": "View today's top tasks and focus momentum",
      "tag": "cadence-today",
      "template": "widget-template",
      "ms_ac_template": "/widgets/today-template.json",
      "data": "/widgets/today-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-wide.png",
          "sizes": "1280x720",
          "label": "Cadence Today Widget Preview"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Cadence Command Center and Today Dashboard"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Cadence Mobile Task OS and Focus Timer"
    }
  ],
  "shortcuts": [
    {
      "name": "Quick Capture",
      "short_name": "Capture",
      "description": "Quickly capture a task with natural language",
      "url": "/?action=capture",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Focus Timer",
      "short_name": "Focus",
      "description": "Start a deep focus round with audio cues",
      "url": "/focus",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Today Dashboard",
      "short_name": "Today",
      "description": "View today's tasks and activity rings",
      "url": "/today",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/?action=capture",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
