{
  "extends": "../../tsconfig.base.json",
  // `tests/**/*` and `playwright.config.ts` were NOT listed here, so the entire
  // E2E suite (~2,000 lines of TypeScript) shipped with no type checking at all.
  // Playwright transpiles without typechecking, so a type error there surfaces
  // as a confusing runtime failure or not at all. `node:fs` resolves via
  // @types/node and the DOM lib is already present.
  "include": ["src/**/*", "tests/**/*", "playwright.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    // See artifacts/api-server/tsconfig.json: --noEmit + inherited
    // `incremental: true` lets a stale .tsbuildinfo mask real type errors.
    // Full check every run.
    "incremental": false,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}
