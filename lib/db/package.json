{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "migrate": "node --experimental-strip-types ./src/migrate-cli.ts",
    "migrate:status": "node --experimental-strip-types ./src/migrate-cli.ts --status",
    "migrate:dry": "node --experimental-strip-types ./src/migrate-cli.ts --dry-run",
    "test": "vitest run",
    "test:db": "vitest run",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.3",
    "drizzle-kit": "^0.31.10",
    "vitest": "catalog:"
  }
}
