# Cadence — M0 environment template (Phase 0).
# Copy to `.env` locally or paste values into Replit Secrets.
# NEVER commit real values — `.gitignore` blocks `.env*` except this file.
# Server-only keys (never prefix with VITE_, never ship to the browser):
#   DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY, CLERK_SECRET_KEY,
#   TELEGRAM_BOT_TOKEN, VAPID_PRIVATE_KEY, GEMINI_API_KEY, LLM_FALLBACK_KEY

# --- Database (Supabase prod; pooled URL at runtime, direct URL for migrations) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (Clerk; publishable key is public, secret stays server-only) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Optional local-dev Clerk proxy; leave empty on Replit/prod
VITE_CLERK_PROXY_URL=

# --- Deployed Production URLs ---
API_BASE_URL=https://cadence-task-os.onrender.com
VITE_API_URL=https://cadence-task-os.onrender.com
FRONTEND_URL=https://cadence-task-os.vercel.app

# --- API server ---
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- Telegram bot (M0: token + your numeric user id; webhook wiring lands in Module 7) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# Shared secret Telegram sends as X-Telegram-Bot-Api-Secret-Token (generate: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# --- Automation dispatch (service-only; never browser, never commit) ---
# Shared secret for POST /internal/dispatch + GET /internal/health (generate: openssl rand -hex 32)
DISPATCH_SECRET=

# --- Web Push VAPID (generate: npx web-push generate-vapid-keys --json) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- LLM (M0: Gemini free-tier first; fallback optional) ---
# !! AN EMPTY VALUE HERE MEANS "NOT CONFIGURED". An empty key is treated as
# !! absent by the provider resolver -- it is NOT a usable credential.
# !! Historically these two lines sat blank and nothing read them, so the agent
# !! silently returned a canned greeting on every message. If the assistant
# !! stops working, check here first.
# Leave every one of these blank and paste a key in Settings instead:
# in-app BYOK (llm_credentials) takes precedence over these env vars.
GEMINI_API_KEY=
LLM_FALLBACK_KEY=
# Optional extras, all OpenAI-compatible /chat/completions endpoints:
# NVIDIA_NIM_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Self-hosted gateway override (wins over everything above):
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
# LITELLM_MODEL=

# --- Credential encryption (required for in-app BYOK) ---
# AES-256-GCM master key for llm_credentials.ciphertext.
# Generate: openssl rand -base64 32
# !! Rotating this invalidates every stored provider key -- users must re-paste.
# !! Deliberately NOT derived from DATABASE_URL: rotating your DB password should
# !! not silently destroy every user's LLM key.
CREDENTIAL_ENCRYPTION_KEY=

# --- Replit runtime (provided by the environment, not secrets) ---
# PORT=
# BASE_PATH=/
# NODE_ENV=development
