{
  "name": "workspace",
  "version": "0.1.5",
  "packageManager": "pnpm@11.20.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "contrast:check": "node scripts/verify-contrast.cjs",
    "db:migrate": "pnpm --filter @workspace/db run migrate",
    "db:status": "pnpm --filter @workspace/db run migrate:status",
    "encoding:check": "node scripts/scan-mojibake.cjs",
    "lint:tokens": "node scripts/lint-tokens.cjs",
    "lint:tokens:report": "node scripts/lint-tokens.cjs --report",
    "preinstall": "node scripts/enforce-pnpm.cjs",
    "test": "pnpm -r --if-present run test",
    "test:db": "pnpm --filter @workspace/db run test:db",
    "test:db:local": "node scripts/db-test-local.cjs",
    "tokens:build": "node scripts/build-tokens.cjs",
    "tokens:check": "node scripts/build-tokens.cjs --check",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "typecheck:full": "pnpm run typecheck:libs:force && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "typecheck:libs": "tsc --build",
    "typecheck:libs:force": "node node_modules/typescript/bin/tsc --build --force",
    "verify": "node scripts/run-gates.cjs",
    "verify:auth-surface": "node scripts/verify-auth-surface.cjs",
    "verify:automation": "node scripts/verify-automation-chain.mjs",
    "verify:cron-routes": "node scripts/verify-cron-routes.cjs",
    "verify:cwv": "node scripts/verify-core-web-vitals.cjs",
    "verify:design-catalog": "node scripts/verify-design-catalog-gated.cjs",
    "verify:e2e": "pnpm --filter @workspace/cadence run test:e2e",
    "verify:e2e:desktop": "pnpm --filter @workspace/cadence run test:e2e --project=desktop-chromium",
    "verify:e2e:install": "pnpm --filter @workspace/cadence exec playwright install chromium",
    "verify:e2e:list": "pnpm --filter @workspace/cadence run test:e2e --list",
    "verify:e2e:smoke": "pnpm --filter @workspace/cadence run test:e2e --grep-invert @known-defect",
    "verify:fast": "node scripts/run-gates.cjs --fast",
    "verify:isolation": "node scripts/verify-two-account-isolation.cjs",
    "verify:list": "node scripts/run-gates.cjs --list",
    "verify:live": "node scripts/verify-live-deployment.cjs",
    "verify:no-dead-classes": "node scripts/verify-no-dead-classes.cjs",
    "verify:sizing": "node scripts/verify-sizing-utilities.cjs",
    "verify:visual": "node scripts/verify-visual-changes.cjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@rollup/rollup-win32-x64-msvc": "^4.63.3"
  },
  "devDependencies": {
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
