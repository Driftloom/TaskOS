    "font": {
      "sans": {
        "value": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", Inter, \"Inter Fallback\", \"Segoe UI Variable Text\", \"Segoe UI\", Roboto, \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Devanagari\", system-ui, sans-serif",
        "type": "fontFamily",
        "_comment": "P7 L262 family strategy, plus the Inter fallback P7 also requires and that was previously unimplemented. `Inter` was named in this stack with no @font-face and no font binary anywhere in the repo, so it resolved for nobody: a family name in a fallback list is a lookup, not a fetch. Every non-Apple user was getting Segoe UI or Roboto against a type scale whose tracking values were drawn against an SF/Inter-style grotesque. index.css now declares Inter (variable, latin subset, self-hosted via @fontsource, no third-party CDN) plus a metric-matched `Inter Fallback` carrying the size-adjust and ascent-override P7 L263 requires, so the focus timer, the line-clamped task titles and the two-line clamps do not shift on swap. Inter sits BEFORE Segoe UI per P7 L262, so the `Segoe UI Variable Text` / `Segoe UI Variable Display` pair added by c4901e0 is no longer reached on Windows 11: Inter wins both cuts. That is intended, since P7 asks for one deliberate cross-platform face. The SF Text / SF Display split that the display token exists for still renders on Apple, where -apple-system matches first and Inter is never fetched at all. This comment previously claimed to be the P7 L262 strategy verbatim; it stopped being true when c4901e0 inserted `Segoe UI Variable Text` and moved `Inter` after `Segoe UI`, and nothing caught the drift."
      },
      "display": {
        "value": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"SF Pro Text\", Inter, \"Inter Fallback\", \"Segoe UI Variable Display\", \"Segoe UI\", Roboto, \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Devanagari\", system-ui, sans-serif",
        "type": "fontFamily",
        "_comment": "P7 L262 family strategy, plus the Inter fallback P7 also requires and that was previously unimplemented. `Inter` was named in this stack with no @font-face and no font binary anywhere in the repo, so it resolved for nobody: a family name in a fallback list is a lookup, not a fetch. Every non-Apple user was getting Segoe UI or Roboto against a type scale whose tracking values were drawn against an SF/Inter-style grotesque. index.css now declares Inter (variable, latin subset, self-hosted via @fontsource, no third-party CDN) plus a metric-matched `Inter Fallback` carrying the size-adjust and ascent-override P7 L263 requires, so the focus timer, the line-clamped task titles and the two-line clamps do not shift on swap. Inter sits BEFORE Segoe UI per P7 L262, so the `Segoe UI Variable Text` / `Segoe UI Variable Display` pair added by c4901e0 is no longer reached on Windows 11: Inter wins both cuts. That is intended, since P7 asks for one deliberate cross-platform face. The SF Text / SF Display split that the display token exists for still renders on Apple, where -apple-system matches first and Inter is never fetched at all. This comment previously claimed to be the P7 L262 strategy verbatim; it stopped being true when c4901e0 inserted `Segoe UI Variable Text` and moved `Inter` after `Segoe UI`, and nothing caught the drift."
      },
      "mono": {
        "value": "ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, \"Cascadia Mono\", monospace",
        "type": "fontFamily",
        "_comment": "P7 L264. \"SF Mono\" is the family name and SFMono-Regular the PostScript name; both are listed because browsers accept either and macOS is inconsistent about which one it exposes to CSS."
      }
