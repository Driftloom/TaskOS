# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
*.log
/coverage
coverage/
.nyc_output/
/libpeerconnection.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
testem.log
/typings

# test artifacts & reports
test-results/
playwright-report/
blob-report/
.playwright/
screenshots/radius-verify*/
screenshots/radius-comparison/

# Legacy chat artifact assets (attached_assets from prior Antigravity sessions)
.conversation/

# System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db
Desktop.ini

# merge / patch residue — never commit a half-resolved conflict
*.orig
*.rej
*.bak
*.tmp
*~

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# env & secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
service-account*.json
secrets.json

# machine-local tooling
.config/
.freebuff/

# local-only agent skills state (managed per machine, never shared)
.agents/
skills-lock.json

# packed tarballs (local native-binary shims, temp installs)
*.tgz

# pnpm content-addressable store (never the repo's, but can land in-tree)
.pnpm-store
.pnpm-debug.log

# deploy / preview tooling state
.vercel
**/.vercel
.netlify
.wrangler
.turbo
**/.turbo
.nx
.render/
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# local Postgres + Supabase CLI state (db-invariants and adoption tests)
pgdata/
postgres-data/
pgpass
.pgpass
service-role.json
supabase/.temp/
supabase/.branches/

# database dumps / exports — real user data, never commit
*.dump
*.sql.gz
*.sql.bz2
*.backup

# vite dev-server output + cache (build output is dist/, already ignored)
dev-dist/
.vite/

# lint caches
.eslintcache

# Lighthouse / Core Web Vitals output. verify-core-web-vitals.cjs serves the
# production build and reports to stdout; these are the artefacts a future
# --output flag or a .lighthouseci run would drop in-tree. Kept separate from the
# Playwright block above because they are different tools with different states.
.lighthouseci/
lighthouse-report/
*.lighthouse.json
.lhci/

# Coverage beyond the /coverage entry above: vitest's native reporters and
# node's built-in coverage output both land in-tree if a run is configured to.
.vitest-coverage/
coverage-final.json
coverage-summary.json

# Editor / OS noise not covered above
.vs/
.idea/workspace.xml
*.swp
*.swo

# Local scratch that agents and humans both create
scratch/
tmp/
*.local
*.diff
*.patch

# Infisical SecretOps local state
.infisical/

# Vitest & Playwright caches
.vitest/
playwright/.cache/

# Windows / Visual Studio user noise
*.suo
*.user
*.userosv
*.sln.docstates

# Android build outputs, packaging, and keystores
*.keystore
*.jks
*.idsig
cadence-android-package.zip
/source/
*.apk
*.aab
*.apks
*.xapk
android/.gradle/
android/app/build/
.gemini/
.antigravity/
.gradle/
android/.gradle/
android/build/
android/app/build/
android/local.properties
